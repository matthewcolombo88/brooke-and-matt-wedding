# --- Supabase ---
# Found in Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Service role key is SERVER-ONLY. Never prefix with NEXT_PUBLIC_. Never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Sessions ---
# Long random string used to sign guest & admin session cookies (JWT, HS256).
# Generate one with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-secret

# --- Site ---
# Used to build absolute URLs (og:image, sitemap, etc). Set to your production domain once deployed.
NEXT_PUBLIC_SITE_URL=https://brooke-and-matt.com

# --- Initial admin bootstrap (used only by scripts/create-admin.ts) ---
ADMIN_BOOTSTRAP_EMAIL=you@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-now
ADMIN_BOOTSTRAP_NAME="Brooke & Matt"
